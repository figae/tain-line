# GitHub OAuth — App erstellen unter: https://github.com/settings/developers
# "New OAuth App" → Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Zufälliger Secret-String (z.B. mit: openssl rand -base64 32)
AUTH_SECRET=your_random_secret

# Optional: Welche GitHub-Accounts Admin-Zugang erhalten (kommagetrennt).
# Leer lassen → alle eingeloggten GitHub-User dürfen rein.
ADMIN_GITHUB_LOGINS=dein_github_handle

# Anthropic API Key für KI-Extraktion
ANTHROPIC_API_KEY=your_anthropic_api_key
