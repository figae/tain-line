# ── Pflicht ────────────────────────────────────────────────────────────────
# Zufälliger Secret-String für Session-JWTs (z.B. mit: openssl rand -base64 32)
AUTH_SECRET=your_random_secret

# ── Optional: GitHub OAuth als zweiter Login-Weg ───────────────────────────
# App erstellen unter: https://github.com/settings/developers
# "New OAuth App" → Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
# Ohne diese Variablen ist nur der E-Mail/Passwort-Login aktiv.
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Welche GitHub-Accounts die Admin-Rolle erhalten (kommagetrennt).
# Alle anderen GitHub-Logins bekommen nur Leserechte.
ADMIN_GITHUB_LOGINS=dein_github_handle

# ── Optional: KI-Extraktion ────────────────────────────────────────────────
# Anthropic API Key für die KI-gestützte Datenerfassung (/admin/extract)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Hinweis Registrierung: Das erste über /register erstellte Konto erhält
# automatisch die Admin-Rolle. Alle weiteren Konten starten als Leser und
# können unter /admin/users befördert werden.
